{
  "name": "chatslock",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "prepare": "lefthook install",
    "layer:build": "bash scripts/build-layer.sh --no-push",
    "layer:push": "bash scripts/build-layer.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:site": "bash scripts/deploy-main-site.sh",
    "infra:apply": "pnpm layer:build && cd infrastructure && terraform init && terraform apply",
    "infra:plan": "pnpm layer:build && cd infrastructure && terraform init && terraform plan",
    "infra:destroy": "cd infrastructure && terraform init && terraform destroy -auto-approve"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "lefthook": "^2.2.2",
    "prettier": "3.9.6",
    "turbo": "^2.11.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
