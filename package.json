{
  "name": "chatslock",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "layer:build": "bash scripts/build-layer.sh --no-push",
    "layer:push": "bash scripts/build-layer.sh",
    "deploy": "pnpm build && bash scripts/build-layer.sh",
    "deploy:site": "bash scripts/deploy-main-site.sh",
    "infra:apply": "pnpm layer:build && cd infrastructure && terraform init && terraform apply",
    "infra:plan": "pnpm layer:build && cd infrastructure && terraform init && terraform plan",
    "infra:destroy": "cd infrastructure && terraform init && terraform destroy -auto-approve"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.6",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
