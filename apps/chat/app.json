{
  "expo": {
    "name": "chatslock",
    "slug": "chatzy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/files/icon-1024.png",
    "scheme": "chatslock",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/files/icon-1024.png",
      "bundleIdentifier": "com.chatslock.app",
      "associatedDomains": ["applinks:chatslock.com", "applinks:www.chatslock.com"],
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.yash.chatzy",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/files/adaptive-icon-foreground-1024.png",
        "backgroundImage": "./assets/files/adaptive-icon-background-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chatslock.com",
              "pathPrefix": "/u"
            },
            {
              "scheme": "https",
              "host": "www.chatslock.com",
              "pathPrefix": "/u"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/files/favicon-196.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/files/splash-icon.png",
          "imageWidth": 76,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow chatslock to access your photos so you can choose a profile picture.",
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "expo-sharing",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow chatslock to access your microphone to record voice messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cb7eff0e-b0bb-40b5-8ac6-113481155f90"
      }
    },
    "owner": "yash-pede"
  }
}
