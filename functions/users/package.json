{
  "name": "users",
  "type": "module",
  "scripts": {
    "build": "esbuild --bundle --format=esm --outfile=./dist/index.mjs --platform=node --target=node24 --packages=external ./src/index.ts",
    "zip": "zip -j lambda.zip dist/index.mjs",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello",
    "deploy": "run-s build zip update"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "npm-run-all2": "^9.0.2"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@hono/aws-lambda": "^1.0.0",
    "hono": "^4.13.13"
  }
}