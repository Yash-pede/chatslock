{
  "name": "ws-connections",
  "type": "module",
  "scripts": {
    "build": "pnpm run check-types && esbuild --bundle --format=esm --outfile=./dist/index.mjs --platform=node --target=node24 --packages=external ./src/index.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^26.1.1",
    "esbuild": "catalog:",
    "eslint": "10.9.1",
    "npm-run-all2": "^9.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "catalog:",
    "@aws-sdk/client-cognito-identity-provider": "catalog:",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@aws-sdk/util-dynamodb": "catalog:",
    "@hono/aws-lambda": "catalog:",
    "@repo/api": "workspace:*",
    "@repo/types": "workspace:*",
    "hono": "catalog:"
  }
}
