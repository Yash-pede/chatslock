{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "AWS_REGION",
    "TABLE_NAME",
    "SECRET_NAME",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_WSAPI_URL",
    "NODE_ENV"
  ]
}
